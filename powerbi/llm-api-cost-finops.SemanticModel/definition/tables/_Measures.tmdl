		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f17fcade-7c10-47a5-a277-9e4cc8fae2ec

	measure 'Spend Signal Insight' =
			
			VAR LatestCost =
			    [Latest Month Invoice Cost]
			
			VAR MoMPct =
			    [Invoice Cost MoM %]
			
			VAR CostText =
			    SWITCH(
			        TRUE(),
			        ISBLANK(LatestCost), "N/A",
			        ABS(LatestCost) >= 1000000,
			            FORMAT(LatestCost / 1000000, "$0.00M"),
			        ABS(LatestCost) >= 1000,
			            FORMAT(LatestCost / 1000, "$0.00K"),
			        FORMAT(LatestCost, "$#,0.00")
			    )
			
			VAR MovementText =
			    SWITCH(
			        TRUE(),
			        ISBLANK(MoMPct),
			            "has no prior-month comparison",
			        MoMPct < 0,
			            "fell " & FORMAT(ABS(MoMPct), "0.0%"),
			        MoMPct > 0,
			            "rose " & FORMAT(ABS(MoMPct), "0.0%"),
			        "was unchanged"
			    )
			
			VAR MovementName =
			    SWITCH(
			        TRUE(),
			        MoMPct < 0, "decline",
			        MoMPct > 0, "increase",
			        "movement"
			    )
			
			RETURN
			    "Latest invoice cost "
			        & MovementText
			        & " to "
			        & CostText
			        & "."
			        & UNICHAR(10)
			        & "Validate whether demand, model mix or efficiency caused the "
			        & MovementName
			        & "."
		lineageTag: 5a3fe257-cd61-43f6-b771-aac819e0b193

	measure 'Concentration Risk Insight' =
			
			VAR ApplicationTable =
			    FILTER(
			        ADDCOLUMNS(
			            ALL(
			                dim_ai_application[application_name]
			            ),
			            "__UsageCost",
			                [Total Usage Invoice Cost]
			        ),
			        [__UsageCost] > 0
			    )
			
			VAR TopApplicationRow =
			    TOPN(
			        1,
			        ApplicationTable,
			        [__UsageCost], DESC,
			        dim_ai_application[application_name], ASC
			    )
			
			VAR TopApplication =
			    CONCATENATEX(
			        TopApplicationRow,
			        dim_ai_application[application_name],
			        ""
			    )
			
			VAR TopApplicationCost =
			    MAXX(
			        TopApplicationRow,
			        [__UsageCost]
			    )
			
			VAR TotalUsageCost =
			    CALCULATE(
			        [Total Usage Invoice Cost],
			        REMOVEFILTERS(dim_ai_application)
			    )
			
			VAR TopApplicationShare =
			    DIVIDE(
			        TopApplicationCost,
			        TotalUsageCost
			    )
			
			RETURN
			    TopApplication
			        & " drives "
			        & FORMAT(TopApplicationShare, "0.0%")
			        & " of usage cost."
			        & UNICHAR(10)
			        & "Prioritize this workload for cost and architecture review."
		lineageTag: 447dfc62-f854-41ef-b341-a2c25791bd7b

	measure 'Decision Priority Insight' =
			
			VAR OpportunityTable =
			    FILTER(
			        ADDCOLUMNS(
			            ALL(
			                fact_ai_optimization_monthly[optimization_type]
			            ),
			            "__Opportunity",
			                [Identified Annualized Savings]
			        ),
			        [__Opportunity] > 0
			    )
			
			VAR TopOpportunityRow =
			    TOPN(
			        1,
			        OpportunityTable,
			        [__Opportunity], DESC,
			        fact_ai_optimization_monthly[optimization_type], ASC
			    )
			
			VAR TopOpportunityType =
			    CONCATENATEX(
			        TopOpportunityRow,
			        fact_ai_optimization_monthly[optimization_type],
			        ""
			    )
			
			VAR TopOpportunityAmount =
			    MAXX(
			        TopOpportunityRow,
			        [__Opportunity]
			    )
			
			VAR TotalOpportunity =
			    CALCULATE(
			        [Identified Annualized Savings],
			        REMOVEFILTERS(
			            fact_ai_optimization_monthly[optimization_type]
			        )
			    )
			
			VAR TotalOpportunityText =
			    SWITCH(
			        TRUE(),
			        ABS(TotalOpportunity) >= 1000000,
			            FORMAT(TotalOpportunity / 1000000, "$0.00M"),
			        ABS(TotalOpportunity) >= 1000,
			            FORMAT(TotalOpportunity / 1000, "$0.00K"),
			        FORMAT(TotalOpportunity, "$#,0.00")
			    )
			
			VAR TopOpportunityShare =
			    DIVIDE(
			        TopOpportunityAmount,
			        TotalOpportunity
			    )
			
			VAR OpportunityName =
			    SWITCH(
			        TopOpportunityType,
			        "BATCH_MIGRATION", "batch migration",
			        "RETRY_REDUCTION", "retry reduction",
			        "CACHE_REUSE_ASSESSMENT", "cache reuse",
			        "MODEL_RIGHTSIZING", "model right-sizing",
			        "TELEMETRY_COVERAGE", "telemetry coverage",
			        LOWER(TopOpportunityType)
			    )
			
			VAR PricingGap =
			    ABS(
			        [Usage-to-Reported Variance %]
			    )
			
			RETURN
			    TotalOpportunityText
			        & " modeled annualized opportunity; "
			        & FORMAT(TopOpportunityShare, "0%")
			        & " comes from "
			        & OpportunityName
			        & "."
			        & UNICHAR(10)
			        & "Validate the "
			        & FORMAT(PricingGap, "0.0%")
			        & " pricing gap before approval."
		lineageTag: 0ca78c5f-49a8-4e56-9f0f-fa243a20c3ec

	measure 'Total Tokens Card Display' =
			
			FORMAT(
			    DIVIDE(
			        [Total Tokens],
			        1000000000
			    ),
			    "0.0"
			) & "B"
		lineageTag: 89d54a4e-006c-41ec-a547-ae1705edc984

	measure 'Quantified Annualized Opportunity' =
			
			VAR Opportunity =
			    [Identified Annualized Savings]
			RETURN
			    IF(
			        Opportunity > 0,
			        Opportunity,
			        BLANK()
			    )
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: f29b98ee-17ae-4e9a-8844-d9a7ce7f22f5

	measure 'Quantified Recommendation Actions' =
			
			COUNTROWS(
			    FILTER(
			        SUMMARIZE(
			            fact_ai_optimization_monthly,
			            fact_ai_optimization_monthly[recommendation_title],
			            fact_ai_optimization_monthly[provider],
			            fact_ai_optimization_monthly[model]
			        ),
			        CALCULATE(
			            [Identified Annualized Savings]
			        ) > 0
			    )
			)
		formatString: 0
		lineageTag: 71e02b6e-348e-40cb-aa49-c41fad2aff90

	column '_Measure Holder'
		lineageTag: 665a0745-7fef-46d9-be52-4eb84645ec32
		summarizeBy: none
		isNameInferred
		sourceColumn: [_Measure Holder]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source =
				
				DATATABLE(
				    "_Measure Holder",
				    STRING,
				    {
				        { "Measures" }
				    }
				)

	annotation PBI_Id = dde717c8c47b42b0af4f38752930eb35

