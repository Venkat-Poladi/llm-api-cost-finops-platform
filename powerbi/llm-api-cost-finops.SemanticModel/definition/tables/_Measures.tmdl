	measure 'Reconciliation Bridge Amount' =
			
			SWITCH(
			    SELECTEDVALUE(
			        'Reconciliation Stage'[Stage]
			    ),
			    "Usage Estimate",
			        [Usage Estimate - Usage Lines],
			    "Usage → Reported Variance",
			        [Usage-to-Reported Variance],
			    "Non-Usage Reported Cost",
			        [Non-Usage Provider Reported Cost],
			    "Reported → Invoice Variance",
			        [Reported-to-Invoice Variance],
			    BLANK()
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 80f5551f-9dd0-4ed0-8b00-5f2ff6d7c734

