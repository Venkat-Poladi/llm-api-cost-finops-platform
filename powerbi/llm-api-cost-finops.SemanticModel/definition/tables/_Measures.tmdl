	measure 'Latest Month Invoice Cost' =
			
			VAR LatestMonth =
			    MAX(dim_ai_date[month_start_date])
			RETURN
			    CALCULATE(
			        [Total Invoice Cost],
			        REMOVEFILTERS(dim_ai_date),
			        dim_ai_date[month_start_date] = LatestMonth
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 857ba3ad-3cec-4ab8-a600-6d8a0d29ba5a

	measure 'Previous Month Invoice Cost' =
			
			VAR LatestMonth =
			    MAX(dim_ai_date[month_start_date])
			
			VAR PriorMonthStart =
			    EDATE(LatestMonth, -1)
			
			RETURN
			    CALCULATE(
			        [Total Invoice Cost],
			        REMOVEFILTERS(dim_ai_date),
			        dim_ai_date[month_start_date] = PriorMonthStart
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e6c7fef4-e4f4-4940-83af-554d8d595ec6

	measure 'Invoice Cost MoM %' =
			
			DIVIDE(
			    [Latest Month Invoice Cost]
			        - [Previous Month Invoice Cost],
			    [Previous Month Invoice Cost]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1c60552a-4a55-405d-8919-b55c8b24b704

	measure 'Executive Readout' =
			
			VAR NL =
			    UNICHAR(10)
			
			VAR Bullet =
			    UNICHAR(8226) & " "
			
			VAR LatestCost =
			    [Latest Month Invoice Cost]
			
			VAR MoMPct =
			    [Invoice Cost MoM %]
			
			VAR LatestCostText =
			    SWITCH(
			        TRUE(),
			        ABS(LatestCost) >= 1000000,
			            FORMAT(LatestCost / 1000000, "$0.00M"),
			        ABS(LatestCost) >= 1000,
			            FORMAT(LatestCost / 1000, "$0.00K"),
			        FORMAT(LatestCost, "$#,0.00")
			    )
			
			VAR MovementText =
			    SWITCH(
			        TRUE(),
			        ISBLANK(MoMPct),
			            "has no prior-month comparison",
			        MoMPct < 0,
			            "fell " & FORMAT(ABS(MoMPct), "0.0%"),
			        MoMPct > 0,
			            "rose " & FORMAT(ABS(MoMPct), "0.0%"),
			        "was unchanged"
			    )
			
			VAR ApplicationTable =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED(
			                dim_ai_application[application_name]
			            ),
			            "__ApplicationCost",
			                [Total Usage Invoice Cost]
			        ),
			        [__ApplicationCost] > 0
			    )
			
			VAR TopApplicationTable =
			    TOPN(
			        1,
			        ApplicationTable,
			        [__ApplicationCost], DESC,
			        dim_ai_application[application_name], ASC
			    )
			
			VAR TopApplication =
			    CONCATENATEX(
			        TopApplicationTable,
			        dim_ai_application[application_name],
			        ""
			    )
			
			VAR TopApplicationCost =
			    MAXX(
			        TopApplicationTable,
			        [__ApplicationCost]
			    )
			
			VAR TotalApplicationCost =
			    CALCULATE(
			        [Total Usage Invoice Cost],
			        ALLSELECTED(dim_ai_application)
			    )
			
			VAR TopApplicationShare =
			    DIVIDE(
			        TopApplicationCost,
			        TotalApplicationCost
			    )
			
			VAR RecommendationTable =
			    FILTER(
			        ADDCOLUMNS(
			            ALLSELECTED(
			                fact_ai_optimization_monthly[recommendation_title]
			            ),
			            "__Opportunity",
			                [Identified Annualized Savings]
			        ),
			        [__Opportunity] > 0
			    )
			
			VAR TopRecommendationTable =
			    TOPN(
			        1,
			        RecommendationTable,
			        [__Opportunity], DESC,
			        fact_ai_optimization_monthly[recommendation_title], ASC
			    )
			
			VAR TopRecommendation =
			    CONCATENATEX(
			        TopRecommendationTable,
			        fact_ai_optimization_monthly[recommendation_title],
			        ""
			    )
			
			VAR TopRecommendationOpportunity =
			    MAXX(
			        TopRecommendationTable,
			        [__Opportunity]
			    )
			
			VAR TotalOpportunity =
			    [Identified Annualized Savings]
			
			VAR TotalOpportunityText =
			    SWITCH(
			        TRUE(),
			        ABS(TotalOpportunity) >= 1000000,
			            FORMAT(TotalOpportunity / 1000000, "$0.00M"),
			        ABS(TotalOpportunity) >= 1000,
			            FORMAT(TotalOpportunity / 1000, "$0.00K"),
			        FORMAT(TotalOpportunity, "$#,0.00")
			    )
			
			VAR TopRecommendationShare =
			    DIVIDE(
			        TopRecommendationOpportunity,
			        TotalOpportunity
			    )
			
			VAR OpportunityType =
			    SWITCH(
			        TRUE(),
			        CONTAINSSTRING(
			            LOWER(TopRecommendation),
			            "batch"
			        ),
			            "batch migration",
			        CONTAINSSTRING(
			            LOWER(TopRecommendation),
			            "retry"
			        ),
			            "retry reduction",
			        TopRecommendation
			    )
			
			VAR ReconciliationPct =
			    [Usage-to-Reported Variance %]
			
			VAR ReconciliationText =
			    SWITCH(
			        TRUE(),
			        ReconciliationPct < 0,
			            FORMAT(
			                ABS(ReconciliationPct),
			                "0.0%"
			            )
			                & " below the usage estimate",
			        ReconciliationPct > 0,
			            FORMAT(
			                ABS(ReconciliationPct),
			                "0.0%"
			            )
			                & " above the usage estimate",
			        "aligned with the usage estimate"
			    )
			
			RETURN
			    "SPEND SIGNAL"
			        & NL
			        & Bullet
			        & "Latest invoice cost "
			        & MovementText
			        & " to "
			        & LatestCostText
			        & ". Validate whether the movement reflects demand, model mix or efficiency."
			        & NL
			        & NL
			        & "CONCENTRATION RISK"
			        & NL
			        & Bullet
			        & TopApplication
			        & " represents "
			        & FORMAT(
			            TopApplicationShare,
			            "0.0%"
			        )
			        & " of usage cost and should be the first workload investigated."
			        & NL
			        & NL
			        & "DECISION PRIORITY"
			        & NL
			        & Bullet
			        & TotalOpportunityText
			        & " of modeled annualized opportunity is identified. "
			        & FORMAT(
			            TopRecommendationShare,
			            "0%"
			        )
			        & " is driven by "
			        & OpportunityType
			        & ". Provider-reported usage is "
			        & ReconciliationText
			        & ", so validate pricing before approval."
		lineageTag: b69c0b01-1ce2-4aa9-aa8a-3ffd2802d4fc

