	column 'Is Latest Optimization Month' =
			
			VAR LatestDateKey =
			    CALCULATE(
			        MAX(
			            fact_ai_optimization_monthly[date_key]
			        ),
			        ALL(
			            fact_ai_optimization_monthly
			        )
			    )
			RETURN
			    IF(
			        fact_ai_optimization_monthly[date_key]
			            = LatestDateKey,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: e5aca9dd-d5de-4780-80a8-18d39799c0c5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Recommendation Display' =
			
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING(
			        LOWER(fact_ai_optimization_monthly[recommendation_title]),
			        "asynchronous"
			    ),
			        "Batch migration",
			
			    CONTAINSSTRING(
			        LOWER(fact_ai_optimization_monthly[recommendation_title]),
			        "retry"
			    ),
			        "Retry reduction",
			
			    fact_ai_optimization_monthly[recommendation_title]
			)
		lineageTag: 47d37ed2-72b3-4932-842a-3581e72af506
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Optimization Type Display' =
			
			SWITCH(
			    fact_ai_optimization_monthly[optimization_type],
			    "BATCH_MIGRATION", "Batch Migration",
			    "RETRY_REDUCTION", "Retry Reduction",
			    "CACHE_REUSE_ASSESSMENT", "Cache Reuse",
			    "MODEL_RIGHTSIZING", "Model Right-Sizing",
			    "TELEMETRY_COVERAGE", "Telemetry Coverage",
			    fact_ai_optimization_monthly[optimization_type]
			)
		lineageTag: 529ab848-e7cc-4f85-a3c9-f6a5f950943e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Evaluation Status Display' =
			
			SWITCH(
			    fact_ai_optimization_monthly[evaluation_gate_status],
			    "READY_FOR_EVALUATION", "Ready",
			    "REQUIRES_BENCHMARK", "Needs Benchmark",
			    "HOLD_FOR_DATA", "Data Hold",
			    fact_ai_optimization_monthly[evaluation_gate_status]
			)
		lineageTag: 336d71d1-6ac7-412d-8039-e459e7240bdb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

